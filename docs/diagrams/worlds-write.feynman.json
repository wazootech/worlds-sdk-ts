{
  "title": "Worlds, part 1: writing a fact",
  "lines": {
    "agent": {
      "stroke": "wave",
      "color": "blue",
      "legend": "the agent decides",
      "len": 160
    },
    "sdk": {
      "stroke": "solid",
      "color": "ink",
      "legend": "Worlds SDK / API code runs",
      "len": 90
    },
    "operator": {
      "stroke": "dashed",
      "color": "orange",
      "legend": "an operator sets up",
      "len": 110
    },
    "rest": {
      "stroke": "dotted",
      "color": "gray",
      "legend": "at rest, nothing running",
      "len": 120
    }
  },
  "vertices": {
    "write": {
      "shape": "diamond",
      "legend": "writes, can be revised"
    },
    "irreversible": {
      "shape": "diamond",
      "color": "red",
      "legend": "cannot be undone",
      "labelColor": true,
      "bold": true
    },
    "index": {
      "shape": "hexagon",
      "color": "purple",
      "legend": "indexed for search"
    }
  },
  "tracks": [
    {
      "id": "main",
      "lane": 0,
      "line": "operator",
      "start": {
        "label": "operator"
      },
      "steps": [
        {
          "vertex": "irreversible",
          "label": "create world",
          "note": "immutable id"
        },
        {
          "line": "operator",
          "len": 95
        },
        {
          "vertex": "irreversible",
          "label": "mint token",
          "note": "shown once"
        },
        {
          "line": "rest",
          "len": 75
        },
        {
          "vertex": "junction",
          "id": "in"
        },
        {
          "line": "agent",
          "label": "Curate",
          "note": [
            "keep durable facts",
            "drop the rest"
          ]
        },
        {
          "vertex": "branch",
          "id": "keep",
          "by": "agent"
        },
        {
          "line": "sdk",
          "label": "new fact",
          "len": 180
        },
        {
          "vertex": "write",
          "label": "import"
        },
        {
          "line": "sdk",
          "len": 300
        },
        {
          "vertex": "write",
          "id": "commit",
          "label": "commit",
          "note": [
            "atomic patch",
            "skips known triples"
          ]
        },
        {
          "line": "sdk",
          "len": 120
        },
        {
          "vertex": "index",
          "label": "index",
          "note": [
            "embed + chunk",
            "failure rolls back"
          ]
        },
        {
          "line": "rest",
          "len": 90
        },
        {
          "vertex": "stop",
          "note": [
            "stored",
            "current state only"
          ]
        }
      ]
    },
    {
      "id": "turn",
      "lane": -1.4,
      "line": "agent",
      "start": {
        "label": "agent turn",
        "note": "conversation · tool output"
      },
      "merge": "in"
    },
    {
      "id": "drop",
      "lane": 1.2,
      "from": "keep",
      "label": "noise",
      "steps": [
        {
          "line": "agent",
          "len": 90
        },
        {
          "vertex": "stop",
          "note": "never stored"
        }
      ]
    },
    {
      "id": "revise",
      "lane": -1.2,
      "line": "sdk",
      "from": "keep",
      "merge": "commit",
      "label": "changed fact",
      "steps": [
        {
          "line": "sdk",
          "len": 60
        },
        {
          "vertex": "irreversible",
          "label": "delete old",
          "note": "no undo"
        },
        {
          "line": "sdk",
          "len": 100
        },
        {
          "vertex": "write",
          "label": "insert new"
        }
      ]
    }
  ]
}
